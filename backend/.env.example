# Copy to backend/.env for local dev. Never commit the real .env.
DEBUG=true
# Must be >= 32 bytes; HS256 signs JWTs with this key (RFC 7518 §3.2).
SECRET_KEY=django-insecure-dev-only-key-change-me-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for zero-dependency local runs. docker-compose overrides this with PostGIS:
#   DATABASE_URL=postgis://aapni:aapni@db:5432/aapni
# (psql:// also works; PostGIS image keeps us GIS-ready without a later engine migration.)
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
