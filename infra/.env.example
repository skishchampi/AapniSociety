# Copy to infra/.env to override docker-compose defaults. Never commit infra/.env.
# Every var here has a safe default in docker-compose.yml; override for non-default runs.

# Postgres (PostGIS image) credentials
POSTGRES_DB=aapni
POSTGRES_USER=aapni
POSTGRES_PASSWORD=aapni

# Django secret used to sign JWTs. Must be >= 32 bytes. Change for any shared env.
SECRET_KEY=django-insecure-dev-only-key-change-me-in-prod
